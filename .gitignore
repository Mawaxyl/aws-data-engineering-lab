venv/
.ipynb_checkpoints/
.pytest_cache/

# ---- IaC state ----
.terraform/
*.tfstate
*.tfstate.*
cdk.out/
.aws-sam/

# ---- spark / local engines ----
spark-warehouse/
metastore_db/
derby.log
warehouse/

